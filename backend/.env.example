# Database
# Default: SQLite (zero setup, works out of the box). To use Postgres, set:
# DATABASE_URL=postgresql+psycopg2://partspulse:partspulse@localhost:5432/partspulse
DATABASE_URL=sqlite:///./partspulse.db

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# External exchange rate API (no key required - Frankfurter)
EXCHANGE_API_BASE_URL=https://api.frankfurter.app
EXCHANGE_API_TIMEOUT_SECONDS=4
EXCHANGE_CACHE_TTL_SECONDS=3600
BASE_CURRENCY=USD

# CORS
CORS_ORIGINS=http://localhost:5173
